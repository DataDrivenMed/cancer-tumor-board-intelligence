# Do not put real credentials in this file.

MODEL_AUTH_TOKEN=
MODEL_NAME=openai/gpt-oss-120b:fireworks-ai
MODEL_BASE_URL=
MODEL_REASONING_EFFORT=high

ENABLE_LIVE_PUBMED=true
PUBMED_EMAIL=
NCBI_API_KEY=

ENABLE_LIVE_CLINICALTRIALS=true

# Narrow built-in open-access AML consensus source used when no explicit
# GUIDELINE_EVIDENCE_JSON/PATH package is configured.
ENABLE_PUBLIC_ELN_GUIDANCE=true

# Primary public molecular source. Anonymous CIViC reads are supported;
# CIVIC_API_KEY is optional and avoids the anonymous rate limit.
CIVIC_API_KEY=

# Primary public safety-label source. A free openFDA key is recommended for
# dependable quota headroom but must never be committed.
OPENFDA_API_KEY=

# Optional governed deployment packages. Inline JSON values can be supplied in
# the deployment secret store; mounted paths are preferable for large packages.
GUIDELINE_EVIDENCE_PATH=
MOLECULAR_EVIDENCE_PATH=
SAFETY_EVIDENCE_PATH=
TRANSLATIONAL_EVIDENCE_PATH=

# Never commit NCCN or other licensed/restricted guideline content. If a source
# explicitly prohibits AI/model/tool use, the product must not ingest it.
# Comma-separated frontend origins allowed to call the FastAPI service.
# Add the exact Vercel production and preview origins during deployment.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional local path for the append-only Phase 8 case-version database.
TUMOR_BOARD_STATE_DB=.local/tumor_board_state.sqlite3
# Production uses managed PostgreSQL. Render supplies this value from the
# database resource; do not copy it into source control.
DATABASE_URL=

# Phase 9 local security defaults. Production research requires explicit,
# non-local values and institutional operations outside this file.
DEPLOYMENT_ENV=local
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
MAX_REQUEST_BYTES=16777216
ENABLE_API_DOCS=true
AUTH_MODE=none
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ORGANIZATION_CLAIM=
OIDC_ROLE_CLAIM=
REQUIRE_HTTPS=false
RATE_LIMITING_MODE=none
MONITORING_SINK=
BACKUP_POLICY=
